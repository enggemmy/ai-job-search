<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed from phase 2 (TMDB). Unused by the provider test screen. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Scoped package visibility (Android 11+): we declare the *kind of intent* we resolve,
        not package names. This lets queryIntentActivities() see which apps can handle an
        https VIEW link, without QUERY_ALL_PACKAGES and without hard-coding any provider
        package identifier.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UnifiedStreamingHub">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.UnifiedStreamingHub">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
